# Postgres (local: `pnpm db:up`)
DATABASE_URL=postgres://jd:jd@localhost:5432/jd_agent

# Anthropic
ANTHROPIC_API_KEY=
# Fast model: extractor, role-diagnosis
MODEL_FAST=claude-haiku-5-5
# Writer model: renderer
MODEL_WRITER=claude-sonnet-5-5

# Access: one shared password, signed session cookie
ACCESS_PASSWORD=
SESSION_SECRET=

# Global usage budget, in USD, across all users
USAGE_BUDGET_USD=50
