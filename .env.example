# Postgres (local: `pnpm db:up`)
DATABASE_URL=postgres://jd:jd@localhost:5432/jd_agent

# Anthropic
ANTHROPIC_API_KEY=
# Fast model: extractor, role-diagnosis
MODEL_FAST=claude-haiku-5-5
# Writer model: renderer
MODEL_WRITER=claude-sonnet-5-5

# Access: one shared password, signed session cookie
ACCESS_PASSWORD=
# At least 32 characters, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Daily usage limit across all users, in tokens per model and direction.
# Sized on 2026-10-23 prices to stay under $5/day (about 24 complete JDs); resets at midnight Europe/Rome.
DAILY_TOKENS_FAST_IN=1000000
DAILY_TOKENS_FAST_OUT=200000
DAILY_TOKENS_WRITER_IN=1750000
DAILY_TOKENS_WRITER_OUT=130000
